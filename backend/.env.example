# 복사해서 backend/.env로 쓴다. 모두 선택이며, 아래는 기본값이다. 비밀 값은 없다.
# 기본 경로는 저장소 밖인 사용자 홈 폴더(${user.home}/.onair/) 아래다. 업로드 영상과 DB 파일은 저장소에 두지 않는다.
# 바꿀 때는 절대 경로를 쓴다(Java는 ~ 를 홈 폴더로 풀지 않는다). Windows에서도 / 를 쓴다.
# 경로를 지정하지 않으려면 해당 줄을 비우지 말고 줄째 주석으로 둔다.

# H2 DB 파일 위치(확장자 제외). 기본: ${user.home}/.onair/db/onair
# H2_DB_PATH=/home/me/.onair/db/onair
# 영상·썸네일 저장 폴더. 기본: ${user.home}/.onair/videos
# STORAGE_DIR=/home/me/.onair/videos
# 업로드 크기 상한. 서버만 바꾸면 된다. 화면은 GET /api/broadcasts/upload-policy로 이 값을 받아 쓴다.
MAX_UPLOAD_SIZE=200MB
# 시그널링 WebSocket의 허용 Origin 패턴(쉼표로 구분). 기본값은 개발 서버(HTTPS 5173)의 모든 호스트와 pnpm dev:local(이 PC의 HTTP 5174)이다.
# ALLOWED_ORIGINS=https://*:5173,http://localhost:5174
# 한 라이브방송의 동시 시청자 상한. 넘으면 새 시청자는 입장하지 못한다. 기본: 5
# MAX_LIVE_VIEWERS=5
# 토스페이먼츠 결제위젯 키(후원). 클라이언트 키는 결제위젯 키(test_gck_...), 시크릿 키는 test_gsk_...이며 토스 문서의 공개 테스트 키를 넣는다. 실제 키는 쓰지 않는다. 비우면 후원 주문이 503이다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 승인 단계 실패를 재현하는 값(예: REJECT_CARD_PAYMENT). 테스트 시크릿 키일 때만 쓰인다. 기본은 비어 있다.
# TOSS_TEST_CODE=
