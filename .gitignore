# 비밀 값 (.env.example은 올린다)
.env
.env.*
!.env.example

# 인증서·개인 키·키 저장소 (개발용 HTTPS 인증서 포함)
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
*.truststore
id_rsa*
id_ed25519*
*.ppk

# 인증 정보가 들어갈 수 있는 로컬 설정
.npmrc
.netrc
*.credentials
credentials*.json
application-local.*
application-secret.*

# 로그 (요청 내용이나 토큰이 찍힐 수 있다)
*.log
logs/

# 실행 중 생기는 데이터: 업로드 영상, H2 DB 파일
data/

# 로컬 작업 자료: 참고 분석, 스펙·티켓
docs/research/
.scratch/

# 빌드 결과물·의존성
backend/build/
backend/.gradle/
frontend/node_modules/
frontend/dist/

# IDE·OS
.idea/
*.iml
.DS_Store
